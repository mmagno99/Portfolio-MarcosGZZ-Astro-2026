---
import Layout from '../layouts/Layout.astro';
import Home from '../components/Home.astro';
import PageContent from '../components/PageContent.astro';
import ProjectDetail from '../components/ProjectDetail.astro';
import { languages, copy, translate, localized, type Lang } from '../lib/i18n';
import { projects, type Project } from '../data/projects';
import PolicyPage from '../views/PolicyPage.astro';
import { policies, type PolicyKey } from '../features/legal/content';
export function getStaticPaths() {
  return languages.flatMap((lang) => {
    const prefix = lang === 'es' ? '' : lang + '/';
    const pages = [
      '',
      'projects',
      'personal-projects',
      'projects-bbx',
      'projects-tdi',
      'about',
      'blog',
      ...Object.keys(policies[lang]),
    ].map((page) => ({
      params: {
        route: localized(lang, page).replace(/^\/+|\/+$/g, '') || undefined,
      },
      props: { lang, page, project: undefined },
    }));
    const details = projects.map((project) => ({
      params: { route: prefix + project.category + '/' + project.id },
      props: { lang, page: project.category + '/' + project.id, project },
    }));
    return [...pages, ...details];
  });
}
interface Props {
  lang: Lang;
  page: string;
  project?: Project;
}
const { lang, page, project }: Props = Astro.props;
const policy = Object.hasOwn(policies[lang], page)
  ? (page as PolicyKey)
  : undefined;
const descriptions: Record<string, string> = {
  projects: copy[lang].workDesc,
  about: copy[lang].aboutDesc,
  blog: copy[lang].journalDesc,
  'projects-tdi': copy[lang].tdiDesc,
  'projects-bbx': copy[lang].bbxDesc,
  'personal-projects': copy[lang].personalDesc,
};
const titles: Record<string, string> = {
  '': copy[lang].homeSEO,
  projects: copy[lang].workTitle,
  'personal-projects': translate(lang, 'projects.personalProjects.title'),
  'projects-bbx': translate(lang, 'projects.bbxProjects.title'),
  'projects-tdi': translate(lang, 'projects.cardtitle3'),
  about: copy[lang].aboutTitle,
  blog: copy[lang].journal,
};
---

<Layout
  lang={lang}
  path={page}
  title={
    project?.name ?? (policy ? policies[lang][policy].title : titles[page])
  }
  image={project?.image}
  description={
    project?.description?.[lang] ??
    (policy ? policies[lang][policy].description : descriptions[page])
  }
>
  {page === '' ? (
    <Home lang={lang} />
  ) : project ? (
    <ProjectDetail lang={lang} project={project} />
  ) : policy ? (
    <PolicyPage lang={lang} policy={policy} />
  ) : (
    <PageContent lang={lang} page={page} />
  )}
</Layout>
