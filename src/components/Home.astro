---
import { copy, translate, localized, type Lang } from '../lib/i18n';
import { personalProjects, tdiProjects } from '../data/projects';
import { skills } from '../data/skills.js';
import about from '../data/about.js';
import ProjectCard from './ProjectCard.astro';
import Contact from './Contact.astro';
import Icon from './Icon.astro';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = copy[lang];
---

<section class="hero-grid relative isolate overflow-hidden bg-[#101020] text-white">
  <div class="orb pointer-events-none absolute -top-40 left-1/3 -z-10 size-[600px] rounded-full bg-indigo-700/25 blur-3xl"></div>
  <div class="orb pointer-events-none absolute -right-24 bottom-0 -z-10 size-96 rounded-full bg-fuchsia-700/20 blur-3xl"></div>
  <div class="shell grid items-center gap-14 pt-16 pb-12 md:min-h-[660px] md:grid-cols-[1.2fr_1fr] md:gap-8 md:pt-24 md:pb-20">
    <div class="page-intro relative z-10">
      <p class="mb-7 inline-flex items-center gap-2.5 rounded-full border border-white/15 bg-white/5 px-4 py-2.5 text-[10px] font-semibold tracking-[.12em] text-indigo-200">
        <span class="size-1.5 rounded-full bg-fuchsia-300"></span>
        {c.role}
      </p>
      <h1 class="max-w-2xl text-[clamp(2.8rem,5.2vw,4.8rem)] leading-[1.09] font-extrabold tracking-[-.055em]">
        {c.hero}
        <br />
        <span class="gradient-text">{c.accent}</span>
      </h1>
      <p class="mt-7 max-w-md text-base leading-8 text-slate-300">{c.intro}</p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href={localized(lang, 'projects')} class="pill primary">
          {c.work}
          <Icon class="size-4" />
        </a>
        <a
          href={localized(lang, 'about')}
          class="pill border border-white/20 bg-white/5 text-white hover:bg-white/10"
        >
          {translate(lang, 'navbar.nav3')}
          <span aria-hidden="true">→</span>
        </a>
      </div>
      <p class="mt-10 text-[11px] font-medium tracking-wide text-slate-400">
        {c.available}
      </p>
    </div>
    <div
      class="relative mx-auto w-full max-w-[450px] pb-10 md:pb-0"
      aria-hidden="true"
    >
      <div class="absolute inset-12 rounded-full bg-linear-to-br from-indigo-500/30 to-fuchsia-500/30 blur-3xl"></div>
      <div class="relative rotate-[-3deg] rounded-2xl border border-white/20 bg-white/8 p-2.5 shadow-2xl backdrop-blur-xl">
        <div class="flex items-center gap-1.5 px-3 py-3">
          <span class="size-2 rounded-full bg-rose-400/80"></span>
          <span class="size-2 rounded-full bg-amber-300/80"></span>
          <span class="size-2 rounded-full bg-emerald-300/80"></span>
          <span class="ml-auto text-[9px] tracking-widest text-slate-400">
            INNOVA MANAGEMENT / SELECTED WORK
          </span>
        </div>
        <div class="overflow-hidden rounded-xl bg-[#181d30]">
          <img
            src="https://ik.imagekit.io/mmagnodev/innova-management.webp?updatedAt=1789752162195"
            alt=""
            width="720"
            height="480"
            fetchpriority="high"
            class="aspect-[3/2] w-full object-cover object-top opacity-90"
          />
        </div>
      </div>
      <div class="float-card absolute -right-2 -bottom-1 w-[75%] rounded-2xl border border-white/20 bg-[#222237]/90 p-5 shadow-2xl backdrop-blur-xl sm:-right-5 md:-bottom-12">
        <div class="mb-3 flex items-center gap-2 text-[10px] text-slate-400">
          <Icon name="code" class="size-4 text-purple-300" /> hello-world.js
        </div>
        <div class="font-mono text-xs leading-6">
          <span class="text-fuchsia-300">const</span> developer = &#123;
          <br />
          <span class="pl-4 text-slate-300">
            name: <span class="text-emerald-300">'Marcos González'</span>,
          </span>
          <br />
          <span class="pl-4 text-slate-300">
            focus: <span class="text-amber-200">'Beautiful experiences'</span>
          </span>
          <br />
          &#125;;
        </div>
      </div>
      <div class="absolute -top-5 -right-1 flex size-16 rotate-12 items-center justify-center rounded-2xl border border-white/20 bg-white/10 text-fuchsia-200 shadow-lg backdrop-blur-lg">
        <Icon name="spark" class="size-8" />
      </div>
    </div>
  </div>
  <div class="border-t border-white/10 bg-white/[.02]">
    <div class="shell flex flex-wrap items-center justify-between gap-5 py-6 text-sm font-semibold tracking-wide text-slate-400">
      {['WordPress', 'React', 'Tailwind CSS', 'Figma', 'PHP', 'Django'].map(
        (name) => (
          <span>{name}</span>
        ),
      )}
    </div>
  </div>
</section>
<section class="section relative overflow-hidden">
  <div class="pointer-events-none absolute right-0 top-20 -z-10 size-96 rounded-full bg-fuchsia-100/70 blur-3xl"></div>
  <div class="shell">
    <div
      data-reveal="fade"
      class="mb-10 flex flex-col justify-between gap-6 sm:flex-row sm:items-end"
    >
      <div>
        <p class="eyebrow mb-4">01 / {translate(lang, 'navbar.nav2')}</p>
        <h2 class="heading">{c.selected}</h2>
        <p class="mt-4 max-w-lg text-sm leading-7 text-slate-500">
          {c.selectedDesc}
        </p>
      </div>
      <a
        href={localized(lang, 'projects')}
        class="inline-flex shrink-0 items-center gap-2 text-sm font-bold text-indigo-600"
      >
        {c.all}
        <Icon class="size-4" />
      </a>
    </div>
    <div data-stagger class="grid gap-7 md:grid-cols-2">
      <div data-reveal="fade">
        <ProjectCard lang={lang} project={personalProjects[0]} />
      </div>
      <div data-reveal="fade">
        <ProjectCard lang={lang} project={tdiProjects[3]} />
      </div>
    </div>
  </div>
</section>
<section class="border-y border-indigo-100/60 bg-linear-to-br from-indigo-50/70 via-white to-fuchsia-50/60 section">
  <div class="shell">
    <div data-reveal="fade" class="mb-12 max-w-2xl">
      <p class="eyebrow mb-4">02 / {translate(lang, 'home.skillsTitle')}</p>
      <h2 class="heading">{c.craft}</h2>
      <p class="mt-5 text-sm leading-7 text-slate-500">{c.craftDesc}</p>
    </div>
    <div data-stagger class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {skills.map((group, index) => (
        <div class="glass p-6">
          <div class="mb-6 flex size-11 items-center justify-center rounded-2xl bg-linear-to-br from-indigo-100 to-fuchsia-100 font-mono text-sm font-bold text-indigo-600">
            {['</>', '{ }', '⌘', '✧'][index]}
          </div>
          <h3 class="mb-5 text-base font-extrabold">
            {group.titleKey ? translate(lang, group.titleKey) : group.title}
          </h3>
          <div class="flex flex-wrap gap-2">
            {group.skills.map((skill) => (
              <span class="tag">{skill.name}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
<section class="section">
  <div class="shell grid items-center gap-12 md:grid-cols-[.85fr_1.15fr] md:gap-20">
    <div data-reveal="scale" class="relative mx-auto w-full max-w-sm">
      <div class="absolute inset-4 rounded-full bg-linear-to-br from-indigo-200 to-fuchsia-200 blur-3xl"></div>
      <div class="glass relative rotate-[-3deg] p-4">
        <img
          src={about.profileImage}
          alt="Marcos González"
          width="500"
          height="500"
          loading="lazy"
          class="aspect-square w-full rounded-2xl object-cover object-top"
        />
      </div>
      <div class="absolute -right-3 bottom-5 rounded-2xl border border-white bg-white/85 px-5 py-4 shadow-lg backdrop-blur-xl">
        <span class="block text-sm font-extrabold">Marcos González</span>
        <span class="mt-1 block text-xs text-indigo-600">
          WordPress & Frontend
        </span>
      </div>
    </div>
    <div data-reveal="fade">
      <p class="eyebrow mb-4">03 / {c.aboutLabel}</p>
      <h2 class="heading">{c.aboutTitle}</h2>
      <p class="mt-6 text-sm leading-8 text-slate-500">
        {translate(lang, 'about.description')}
      </p>
      <a href={localized(lang, 'about')} class="pill secondary mt-7">
        {c.aboutLink}
        <Icon class="size-4" />
      </a>
    </div>
  </div>
</section>
<Contact lang={lang} />
