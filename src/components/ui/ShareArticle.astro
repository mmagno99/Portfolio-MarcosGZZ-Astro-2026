---
import type { Lang } from '../../lib/i18n';
import { uiCopy } from './copy';
import SocialIcon from './SocialIcon.astro';
interface Props {
  lang: Lang;
  url: string;
  title: string;
}
const { lang, url, title } = Astro.props;
const ui = uiCopy[lang];
const networks = [
  {
    name: 'LinkedIn',
    icon: 'linkedin' as const,
    href:
      'https://www.linkedin.com/sharing/share-offsite/?' +
      new URLSearchParams({ url }),
  },
  {
    name: 'Facebook',
    icon: 'facebook' as const,
    href:
      'https://www.facebook.com/sharer/sharer.php?' +
      new URLSearchParams({ u: url }),
  },
  {
    name: 'Twitter / X',
    icon: 'x' as const,
    href:
      'https://x.com/intent/tweet?' +
      new URLSearchParams({ url, text: title, lang }),
  },
];
---

<nav
  data-article-share
  aria-label={ui.shareTitle}
  class="glass px-6 py-7 sm:px-8"
>
  <p class="text-sm font-extrabold text-ink">{ui.shareTitle}</p>
  <div class="mt-5 flex flex-wrap gap-3">
    {networks.map((network) => (
      <a
        href={network.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${ui.shareOn} ${network.name} (${ui.newTab})`}
        class="inline-flex min-h-11 items-center justify-center gap-2.5 rounded-full border border-indigo-100 bg-white px-5 py-2.5 text-sm font-semibold text-indigo-700 transition hover:border-indigo-300 hover:bg-indigo-50"
        style="--social-bg: #fff;"
      >
        <SocialIcon name={network.icon} class="size-4 shrink-0" />
        {network.name}
      </a>
    ))}
  </div>
</nav>
