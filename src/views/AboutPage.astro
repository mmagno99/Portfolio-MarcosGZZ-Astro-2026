---
import { copy, translate, type Lang } from '../lib/i18n';
import Contact from '../components/Contact.astro';
import Icon from '../components/Icon.astro';
import PageHeader from '../components/PageHeader.astro';
interface Props {
  lang: Lang;
  page?: string;
}
const { lang } = Astro.props;
const c = copy[lang];
import about from '../data/about.js';
---

<PageHeader
  title={c.aboutTitle}
  description={c.aboutDesc}
  label={translate(lang, 'navbar.nav3')}
/>

<section class="shell section">
  <div class="grid items-start gap-12 md:grid-cols-[.65fr_1.35fr]">
    <aside data-reveal="scale" class="glass p-5 md:sticky md:top-28">
      <img
        src={about.profileImage}
        alt="Marcos González"
        width="500"
        height="500"
        class="aspect-square w-full rounded-2xl object-cover object-top"
      />
      <div class="p-4">
        <h2 class="text-xl font-extrabold">{about.name}</h2>
        <p class="mt-2 text-sm text-indigo-600">{c.profileRole}</p>
        <a
          href="/assets/cv/Marcos_Gonzalez_CV_Desarrollador_Web.pdf"
          download="Marcos_Gonzalez_CV_Desarrollador_Web.pdf"
          class="pill primary mt-6 w-full"
        >
          {c.downloadCV}
          <Icon name="document" class="size-4" />
        </a>
      </div>
    </aside>
    <div>
      <h2 class="mb-9 text-3xl font-extrabold tracking-tight">
        {c.experience}
      </h2>
      <div class="space-y-6 border-l border-indigo-200 pl-6">
        {about.jobs.map((job) => (
          <article data-reveal="fade" class="glass relative p-6 sm:p-8">
            <span class="absolute top-9 -left-[31px] size-3 rounded-full border-2 border-paper bg-indigo-500"></span>
            <p class="mb-3 text-xs font-semibold text-indigo-600">
              {translate(lang, job.dateKey)}
            </p>
            <h3 class="text-xl font-extrabold">{translate(lang, job.jobKey)}</h3>
            <p class="mt-1 font-semibold text-slate-500">{job.company}</p>
            <p class="mt-5 text-sm leading-8 text-slate-500">
              {translate(lang, job.descjobKey)}
            </p>
            {job.recommendationUrl && (
              <a
                href={job.recommendationUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-indigo-600"
              >
                {translate(lang, 'about.button.title')}
                <Icon class="size-4" />
              </a>
            )}
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<Contact lang={lang} />
