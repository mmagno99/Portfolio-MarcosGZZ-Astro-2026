---
import PageHeader from '../components/PageHeader.astro';
import {
  policies,
  policyDate,
  type PolicyKey,
} from '../features/legal/content';
import { uiCopy } from '../components/ui/copy';
import { localized, type Lang } from '../lib/i18n';
interface Props {
  lang: Lang;
  policy: PolicyKey;
}
const { lang, policy } = Astro.props;
const content = policies[lang][policy];
const ui = uiCopy[lang];
const related = (Object.keys(policies[lang]) as PolicyKey[]).filter(
  (key) => key !== policy,
);
---

<PageHeader
  title={content.title}
  description={content.description}
  label={ui.legal}
/>
<section class="shell section">
  <article class="glass mx-auto max-w-4xl p-6 sm:p-10 md:p-14">
    <p class="mb-9 text-xs font-semibold text-slate-500">
      {content.updated}:{' '}
      <time datetime={policyDate}>
        {new Date(policyDate + 'T12:00:00Z').toLocaleDateString(lang, {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
          timeZone: 'UTC',
        })}
      </time>
    </p>
    <div class="space-y-9">
      {content.sections.map((section) => (
        <section>
          <h2 class="text-xl font-extrabold tracking-tight text-ink">
            {section.title}
          </h2>
          {section.paragraphs.map((paragraph) => (
            <p class="mt-4 text-sm leading-8 text-slate-600">{paragraph}</p>
          ))}
        </section>
      ))}
    </div>
    {policy === 'privacy-policy' && (
      <a
        class="mt-8 inline-block text-sm font-semibold text-indigo-600 underline underline-offset-4"
        href="https://www.whatsapp.com/legal/privacy-policy"
        target="_blank"
        rel="noopener noreferrer"
      >
        WhatsApp · {ui.privacy}
      </a>
    )}
    <div class="mt-10 flex flex-wrap gap-4 border-t border-indigo-100 pt-8">
      <a href="mailto:contacto@marcosgzz.tech" class="pill primary">
        contacto@marcosgzz.tech
      </a>
      {related.map((key) => (
        <a href={localized(lang, key)} class="pill secondary">
          {policies[lang][key].title}
        </a>
      ))}
    </div>
  </article>
</section>
